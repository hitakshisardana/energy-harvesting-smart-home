# --- Python ---
__pycache__/
*.py[cod]
.venv/
venv/
env/
*.egg-info/
.ipynb_checkpoints/

# --- data & generated output (regenerate with the scripts) ---
data/raw/*
data/processed/*
reports/*
*.parquet

# but DO commit the small curated result set -- a repo with no evidence in it
# looks like code that has never been run. Keep this directory tiny: the
# headline tables and a few PNGs, not every run.
!reports/committed/
!reports/committed/**

# --- models / logs ---
*.pt
*.pth
*.ckpt
runs/
mlruns/
wandb/

# --- OS / editor ---
.DS_Store
Thumbs.db
.vscode/
.idea/
~$*.docx

# keep folder placeholders
!**/.gitkeep

# --- gait kinetics dataset (Horst 2017, ~500 MB; fetched manually, not committed) ---
gait/
